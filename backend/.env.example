APP_NAME=CipherChat
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/cipherchat

SECRET_KEY=CHANGE_ME

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

# Refresh-token cookie transport
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# Comma-separated origins allowed by CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Comma-separated hosts accepted by TrustedHost (dev default allows all)
ALLOWED_HOSTS=*

# Optional Redis for multi-worker rate limiting
# REDIS_URL=redis://localhost:6379/0

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

SMTP_FROM_EMAIL=your_email@gmail.com
SMTP_FROM_NAME=CipherChat

MASTER_KEY=
